# ─── Legis Connect — Variáveis de Ambiente (Produção) ─────────────────────────
# Copie este arquivo e configure os valores reais no Vercel Dashboard em:
# https://vercel.com/team/legis/legis/settings/environment-variables
#
# NÃO comite valores reais. Este arquivo é apenas um template de documentação.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Supabase (Obrigatório) ────────────────────────────────────────────────────
# URL do projeto Supabase de produção
# Ex: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Chave anônima pública do Supabase (safe to expose, protegida por RLS)
# Encontre em: Supabase Dashboard → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=

# ─── Gemini AI (Obrigatório) ───────────────────────────────────────────────────
# NÃO configure no frontend. A API key do Gemini deve estar APENAS no servidor.
# Configure no Vercel Dashboard como variável de ambiente SERVER-ONLY (sem prefixo VITE_)
GEMINI_API_KEY=

# ─── Monitoramento / Sentry (Opcional) ────────────────────────────────────────
# DSN do projeto Sentry para captura de erros em produção
# Encontre em: sentry.io → Settings → Projects → Client Keys (DSN)
VITE_SENTRY_DSN=

# ─── Feature Flags (Opcional) ─────────────────────────────────────────────────
# Ativa o modo Beta Fechado (exibe banner e botão de feedback)
VITE_IS_BETA=true

# Versão da aplicação (exibida no health check e Sentry releases)
VITE_APP_VERSION=1.0.0-beta

# ─── URLs (Opcional — usa defaults se não configurado) ─────────────────────────
# URL pública de produção
VITE_APP_URL=https://legisconnect.com.br
