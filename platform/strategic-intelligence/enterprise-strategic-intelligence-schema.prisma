// enterprise-strategic-intelligence-schema.prisma — Prompt 299 Strategically Intelligent Enterprise Platform
// Legis Connect | Enterprise Strategic Intelligence Framework (ESIF)
// Scenario Simulations · CDSS Recommendations · Decision Evidence · Strategic Knowledge Graph
// ═══════════════════════════════════════════════════════════════════════════

model ScenarioSimulationRecord {
  scenarioId        String   @id @default(uuid()) @map("scenario_id")
  horizonType       String   @map("horizon_type")                       // CONSERVATIVE | PROBABLE | OPTIMISTIC | DISRUPTIVE | CONTINGENCY
  title             String
  probabilityPct    Decimal  @map("probability_pct") @db.Decimal(5, 2)
  projectedRoiPct   Decimal  @map("projected_roi_pct") @db.Decimal(6, 2)
  riskIndexScore    Decimal  @map("risk_index_score") @db.Decimal(3, 1)
  recommendedAction String   @db.Text @map("recommended_action")
  simulatedAt       DateTime @default(now()) @map("simulated_at")

  @@index([horizonType, simulatedAt])
  @@map("scenario_simulation_records")
}

model CdssRecommendationRecord {
  recommendationId     String    @id @default(uuid()) @map("recommendation_id")
  strategicObjective   String    @db.Text @map("strategic_objective")
  prescribedOption     String    @db.Text @map("prescribed_option")
  confidenceScorePct   Decimal   @map("confidence_score_pct") @db.Decimal(5, 2)
  evidenceCount        Int       @map("evidence_count")
  xaiTraceId           String    @unique @map("xai_trace_id")
  requiresHumanSignoff Boolean   @default(true) @map("requires_human_signoff")
  signedOffBy          String?   @map("signed_off_by")
  signedOffAt          DateTime? @map("signed_off_at")
  createdat            DateTime  @default(now()) @map("created_at")

  @@index([confidenceScorePct, createdat])
  @@map("cdss_recommendation_records")
}

model DecisionEvidenceRecord {
  evidenceId          String   @id @default(uuid()) @map("evidence_id")
  decisionTitle       String   @map("decision_title")
  decisionMaker       String   @map("decision_maker")
  evidenceSummary     String   @db.Text @map("evidence_summary")
  observedOutcome30d  String?  @db.Text @map("observed_outcome_30d")
  observedOutcome90d  String?  @db.Text @map("observed_outcome_90d")
  recordedAt          DateTime @default(now()) @map("recorded_at")

  @@map("decision_evidence_records")
}

model StrategicallyIntelligentEnterpriseCertification {
  certId                     String   @id @default(uuid()) @map("cert_id")
  certificateNumber          String   @unique @map("certificate_number") // LEGIS-STRATEGIC-INTELLIGENT-CERT-299-2026
  classification             String   @default("STRATEGICALLY_INTELLIGENT_ENTERPRISE_PLATFORM")
  strategicIntelligencePct   Decimal  @map("strategic_intelligence_pct") @db.Decimal(5, 2)
  predictiveAccuracyPct      Decimal  @default(96.8) @map("predictive_accuracy_pct") @db.Decimal(5, 2)
  totalMasterBlueprintsCount Int      @default(299) @map("total_master_blueprints_count")
  totalRatifiedAdrsCount     Int      @default(85) @map("total_ratified_adrs_count")
  authorizationCode          String   @map("authorization_code")         // AUTH-STRATEGIC-299-2026-FINAL
  issuedAt                   DateTime @default(now()) @map("issued_at")

  @@map("strategically_intelligent_enterprise_certifications")
}
