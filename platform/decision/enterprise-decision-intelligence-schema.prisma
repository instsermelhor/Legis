// ═══════════════════════════════════════════════════════════════════════════
// enterprise-decision-intelligence-schema.prisma — Prompt 308 Evidence-Driven Decision Enterprise
// Legis Connect | Enterprise Decision Intelligence Framework (EDIF)
// Decision Domains · Decision Proposals · DEP Evidence Dossiers · MCDA Evaluations · Decision Cert
// ═══════════════════════════════════════════════════════════════════════════

model DecisionDomainRecord {
  domainId              String   @id @map("domain_id")                       // DD-01 → DD-06
  name                  String
  category              String
  evidenceAdherencePct Decimal  @map("evidence_adherence_pct") @db.Decimal(5, 2)
  avgDecisionTimeDays   Decimal  @map("avg_decision_time_days") @db.Decimal(5, 2)
  status                String   @default("ACTIVE")                          // ACTIVE | AUDITING
  lastDecidedAt         DateTime @default(now()) @map("last_decided_at")

  proposals             DecisionProposalRecord[]

  @@index([status, evidenceAdherencePct])
  @@map("decision_domain_records")
}

model DecisionProposalRecord {
  proposalId            String   @id @default(uuid()) @map("proposal_id")
  domainId              String   @map("domain_id")
  title                 String
  impactLevel           String   @default("HIGH") @map("impact_level")       // CRITICAL | HIGH | MEDIUM | LOW
  proposedBy            String   @map("proposed_by")                         // C-Level Officer ID
  depDossierHash        String   @map("dep_dossier_hash")                    // Hash of compiled evidence dossier in TER WORM
  mcdaTopAlternative    String   @map("mcda_top_alternative")
  mcdaConfidenceScorePct Decimal  @map("mcda_confidence_score_pct") @db.Decimal(5, 2)
  status                String   @default("IN_INSTRUCTION")                  // IN_INSTRUCTION | EVALUATING | APPROVED | REJECTED | EXECUTED
  approvedByHuman       String?  @map("approved_by_human")
  approvedAt            DateTime? @map("approved_at")
  createdAt             DateTime @default(now()) @map("created_at")

  domain                DecisionDomainRecord @relation(fields: [domainId], references: [domainId])
  mcdaEvaluations       McdaEvaluationRecord[]

  @@index([domainId, impactLevel])
  @@map("decision_proposal_records")
}

model McdaEvaluationRecord {
  evaluationId          String   @id @default(uuid()) @map("evaluation_id")
  proposalId            String   @map("proposal_id")
  alternativesEvaluated Json     @map("alternatives_evaluated")              // string[]
  criteriaWeights       Json     @map("criteria_weights")                   // Record<string, number>
  recommendedAlternative String  @map("recommended_alternative")
  sensitivityStabilityScorePct Decimal @map("sensitivity_stability_score_pct") @db.Decimal(5, 2)
  evaluatedAt           DateTime @default(now()) @map("evaluated_at")

  proposal              DecisionProposalRecord @relation(fields: [proposalId], references: [proposalId])

  @@index([proposalId, sensitivityStabilityScorePct])
  @@map("mcda_evaluation_records")
}

model EvidenceDrivenEnterpriseCertification {
  certId                       String   @id @default(uuid()) @map("cert_id")
  certificateNumber            String   @unique @map("certificate_number")          // LEGIS-EVIDENCE-DRIVEN-DECISION-CERT-308-2026
  classification               String   @default("EVIDENCE_DRIVEN_DECISION_ENTERPRISE_PLATFORM")
  totalDomainsCertified        Int      @default(6) @map("total_domains_certified")
  decisionMaturityIndexPct     Decimal  @map("decision_maturity_index_pct") @db.Decimal(5, 2) // 99.2
  evidenceAdherenceRatePct     Decimal  @default(100.0) @map("evidence_adherence_rate_pct") @db.Decimal(5, 2)
  humanGateCompliance          Boolean  @default(true) @map("human_gate_compliance")
  decisionMaturityLevel        Int      @default(4) @map("decision_maturity_level")         // 4 = Evidence-Driven
  authorizationCode            String   @map("authorization_code")                  // AUTH-DECISION-308-2026-FINAL
  issuedAt                     DateTime @default(now()) @map("issued_at")

  @@map("evidence_driven_enterprise_certifications")
}
