// perpetual-evolution-schema.prisma — Prompt 285 Perpetual Enterprise Platform
// Legis Connect | Enterprise Perpetual Evolution, Antifragility & Innovation Governance
// TRL Pipeline · Emerging Tech Observatory · Antifragility Engine · Future Readiness
// ═══════════════════════════════════════════════════════════════════════════

model EmergingTechSignalRecord {
  signalId              String   @id @default(uuid()) @map("signal_id")
  domain                String                                                   // AI_LLMS | CRYPTOGRAPHY | INFRASTRUCTURE | INTEROPERABILITY | REGULATION
  technology            String
  currentTrl            Int      @map("current_trl") @db.SmallInt               // 1–9
  futureReadinessPct    Decimal  @map("future_readiness_pct") @db.Decimal(5, 2)
  recommendedAction     String   @map("recommended_action")                      // MONITOR | PROTOTYPE | PILOT | ADOPT
  scannedAt             DateTime @default(now()) @map("scanned_at")

  @@index([domain, recommendedAction])
  @@map("emerging_tech_signal_records")
}

model InnovationPipelineEntry {
  entryId           String   @id @default(uuid()) @map("entry_id")
  initiative        String
  currentTrl        Int      @map("current_trl") @db.SmallInt                   // 1–9
  status            String                                                       // EXPLORATION | PROTOTYPE | PILOT | ADOPTED
  approvalRequired  String   @map("approval_required")
  adrRequired       Boolean  @default(false) @map("adr_required")
  relatedAdrId      String?  @map("related_adr_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([status, currentTrl])
  @@map("innovation_pipeline_entries")
}

model AntifragilityIncidentRecord {
  incidentId                          String    @id @map("incident_id")
  severity                            String                                     // LOW | MEDIUM | HIGH | CRITICAL
  constitutionalImpactAssessment      String    @db.Text @map("constitutional_impact_assessment")
  opaPolicyUpdateProposed             Boolean   @map("opa_policy_update_proposed")
  architectureFitnessFunctionImprovement String @db.Text @map("architecture_fitness_function_improvement")
  adChainUpdateRequired               Boolean   @map("ad_chain_update_required")
  postMortemDeadlineHours             Int       @map("post_mortem_deadline_hours")
  postMortemCompletedAt               DateTime? @map("post_mortem_completed_at")
  detectedAt                          DateTime  @default(now()) @map("detected_at")

  @@index([severity, detectedAt])
  @@map("antifragility_incident_records")
}

model ArchitectureFitnessFunctionResult {
  resultId          String   @id @default(uuid()) @map("result_id")
  functionName      String   @map("function_name")
  category          String                                                       // COUPLING | API_CONTRACT | OBSERVABILITY | POLICY_COMPLIANCE
  scorePct          Decimal  @map("score_pct") @db.Decimal(5, 2)
  passedThreshold   Boolean  @map("passed_threshold")
  buildId           String   @map("build_id")
  evaluatedAt       DateTime @default(now()) @map("evaluated_at")

  @@index([functionName, evaluatedAt])
  @@map("architecture_fitness_function_results")
}

model PerpetualEnterpriseCertification {
  certId                     String   @id @default(uuid()) @map("cert_id")
  certificateNumber          String   @unique @map("certificate_number")         // LEGIS-PERPETUAL-ENTERPRISE-CERT-285-2026
  classification             String   @default("PERPETUAL_ENTERPRISE_PLATFORM")
  antifragilityIndexPct      Decimal  @map("antifragility_index_pct") @db.Decimal(5, 2)
  futureReadinessScorePct    Decimal  @map("future_readiness_score_pct") @db.Decimal(5, 2)
  architectureFitnessScorePct Decimal @map("architecture_fitness_score_pct") @db.Decimal(5, 2)
  innovationPipelineCoveragePct Decimal @map("innovation_pipeline_coverage_pct") @db.Decimal(5, 2)
  techAdoptionVelocityCycles Decimal  @map("tech_adoption_velocity_cycles") @db.Decimal(4, 1)
  authorizationCode          String   @map("authorization_code")                 // AUTH-PERPETUAL-ENTERPRISE-285-2026-FINAL
  issuedAt                   DateTime @default(now()) @map("issued_at")

  @@map("perpetual_enterprise_certifications")
}
