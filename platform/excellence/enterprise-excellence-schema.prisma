// enterprise-excellence-schema.prisma — Prompt 296 Outcome-Driven Intelligent Enterprise Platform
// Legis Connect | Enterprise Operational Excellence Framework (EOEF)
// Value Streams · OKRs & KPIs · Customer Observatory · Continuous Improvement
// ═══════════════════════════════════════════════════════════════════════════

model ValueStreamRecord {
  streamId                 String   @id @map("stream_id")                      // VS-01, VS-02, VS-03
  streamName               String   @map("stream_name")
  baselineCycleTimeMinutes Decimal  @map("baseline_cycle_time_minutes") @db.Decimal(8, 2)
  currentCycleTimeMinutes  Decimal  @map("current_cycle_time_minutes") @db.Decimal(8, 2)
  improvementPercentage    Decimal  @map("improvement_percentage") @db.Decimal(5, 2)
  status                   String   @default("OPTIMIZED")                      // OPTIMIZED | IN_PROGRESS | NEEDS_KAIZEN
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("value_stream_records")
}

model OkrProgressRecord {
  okrId                 String   @id @default(uuid()) @map("okr_id")
  objective             String   @db.Text
  keyResult             String   @db.Text @map("key_result")
  targetValue           Decimal  @map("target_value") @db.Decimal(10, 2)
  currentValue          Decimal  @map("current_value") @db.Decimal(10, 2)
  achievementPercentage Decimal  @map("achievement_percentage") @db.Decimal(5, 2)
  evaluatedAt           DateTime @default(now()) @map("evaluated_at")

  @@index([okrId, evaluatedAt])
  @@map("okr_progress_records")
}

model CustomerValueMetricRecord {
  metricId             String   @id @default(uuid()) @map("metric_id")
  globalNps            Int      @map("global_nps")
  annualCostSavingsUSD Decimal  @map("annual_cost_savings_usd") @db.Decimal(12, 2)
  customerEffortScore  Decimal  @map("customer_effort_score") @db.Decimal(3, 2)
  recordedAt           DateTime @default(now()) @map("recorded_at")

  @@map("customer_value_metric_records")
}

model EnterpriseOperationalExcellenceCertification {
  certId                     String   @id @default(uuid()) @map("cert_id")
  certificateNumber          String   @unique @map("certificate_number") // LEGIS-ENTERPRISE-OPERATIONAL-EXCELLENCE-CERT-296-2026
  classification             String   @default("OUTCOME_DRIVEN_INTELLIGENT_ENTERPRISE_PLATFORM")
  enterpriseExcellenceIndexPct Decimal @map("enterprise_excellence_index_pct") @db.Decimal(5, 2)
  globalNps                  Int      @default(88) @map("global_nps")
  totalMasterBlueprintsCount Int      @default(296) @map("total_master_blueprints_count")
  totalRatifiedAdrsCount     Int      @default(82) @map("total_ratified_adrs_count")
  authorizationCode          String   @map("authorization_code")         // AUTH-EXCELLENCE-296-2026-FINAL
  issuedAt                   DateTime @default(now()) @map("issued_at")

  @@map("enterprise_operational_excellence_certifications")
}
