// metagovernance-schema.prisma — Prompt 275 Enterprise Meta-Governance
// Legis Connect | Eternally Governed Enterprise Platform
// Meta-Governance · Independent Assurance · ISO 42001 · Constitutional Governance
// ═══════════════════════════════════════════════════════════════════════════

model AssuranceAuditRecord {
  auditId                 String   @id @default(uuid()) @map("audit_id")
  domain                  String                                                     // ARCHITECTURE | SECURITY | AI_ETHICS | COMPLIANCE | OPERATIONS
  scorePct                Decimal  @map("score_pct") @db.Decimal(5, 2)
  unresolvedRedFlagsCount Int      @default(0) @map("unresolved_red_flags_count")
  passed                  Boolean  @default(true)
  auditedAt               DateTime @default(now()) @map("audited_at")

  @@index([domain, passed])
  @@map("assurance_audit_records")
}

model ConstitutionalVersionRecord {
  versionId              String   @id @default(uuid()) @map("version_id")
  versionNumber          String   @unique @map("version_number")               // LCERA Constitution v1.0
  amendmentTitle         String   @map("amendment_title")
  unanimousBoardApproval Boolean  @default(true) @map("unanimous_board_approval")
  zeroTrustVerified      Boolean  @default(true) @map("zero_trust_verified")
  enactedAt              DateTime @default(now()) @map("enacted_at")

  @@map("constitutional_version_records")
}

model GovernanceEffectivenessRecord {
  recordId               String   @id @default(uuid()) @map("record_id")
  decisionQualityIndexPct Decimal  @map("decision_quality_index_pct") @db.Decimal(5, 2)
  policyComplianceRatePct Decimal  @map("policy_compliance_rate_pct") @db.Decimal(5, 2)
  boardAlignmentPct      Decimal  @map("board_alignment_pct") @db.Decimal(5, 2)
  evaluatedAt            DateTime @default(now()) @map("evaluated_at")

  @@map("governance_effectiveness_records")
}

model EternalEnterpriseCertification {
  certId                String   @id @default(uuid()) @map("cert_id")
  certificateNumber     String   @unique @map("certificate_number")            // LEGIS-ETERNAL-ENTERPRISE-CERT-2026
  classification        String   @default("ETERNALLY_GOVERNED_ENTERPRISE_PLATFORM")
  metaGovernanceScore   Decimal  @map("meta_governance_score") @db.Decimal(5, 2)
  authorizationCode     String   @map("authorization_code")                    // AUTH-ETERNAL-2026-FINAL
  issuedAt              DateTime @default(now()) @map("issued_at")

  @@map("eternal_enterprise_certifications")
}
