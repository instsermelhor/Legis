model FederatedKnowledgeRecord {
  federationId     String   @id @default(uuid()) @map("federation_id")
  sourceSubsystem  String   @map("source_subsystem")                    // KNOWLEDGE_BRAIN | EVIDENCE_REPO | HERITAGE_REPO | DIGITAL_TWIN
  chunkCount       Int      @map("chunk_count")
  queryLatencyMs   Int      @map("query_latency_ms")
  status           String   @default("SYNCHRONIZED")
  lastFederatedAt  DateTime @default(now()) @map("last_federated_at")

  @@index([sourceSubsystem, status])
  @@map("federated_knowledge_records")
}

model CoherenceAuditRecord {
  auditId                String   @id @default(uuid()) @map("audit_id")
  subsystem              String
  codeVsBlueprintMatch   Boolean  @map("code_vs_blueprint_match")
  opaVsConstitutionMatch Boolean  @map("opa_vs_constitution_match")
  schemaVsModelMatch     Boolean  @map("schema_vs_model_match")
  auditedAt              DateTime @default(now()) @map("audited_at")

  @@index([subsystem, auditedAt])
  @@map("coherence_audit_records")
}

model InstitutionalHarmonyRecord {
  recordId               String   @id @default(uuid()) @map("record_id")
  enterpriseHarmonyIndex Decimal  @map("enterprise_harmony_index") @db.Decimal(5, 2)
  coherenceRatePct       Decimal  @default(100.0) @map("coherence_rate_pct") @db.Decimal(5, 2)
  totalIntegratedPrompts Int      @default(293) @map("total_integrated_prompts")
  totalRatifiedAdrs      Int      @default(79) @map("total_ratified_adrs")
  recordedAt             DateTime @default(now()) @map("recorded_at")

  @@map("institutional_harmony_records")
}

model PerpetuallyAdaptiveEnterpriseCertification {
  certId                       String   @id @default(uuid()) @map("cert_id")
  certificateNumber            String   @unique @map("certificate_number") // LEGIS-PERPETUAL-ADAPTIVE-ENTERPRISE-CERT-293-2026
  classification               String   @default("PERPETUALLY_ADAPTIVE_INTELLIGENT_ENTERPRISE_PLATFORM")
  enterpriseHarmonyIndexPct    Decimal  @map("enterprise_harmony_index_pct") @db.Decimal(5, 2)
  systemicCoherencePct         Decimal  @default(100.0) @map("systemic_coherence_pct") @db.Decimal(5, 2)
  totalMasterBlueprintsCount   Int      @default(293) @map("total_master_blueprints_count")
  totalRatifiedAdrsCount       Int      @default(79) @map("total_ratified_adrs_count")
  authorizationCode            String   @map("authorization_code")         // AUTH-SINGULARITY-293-2026-FINAL
  issuedAt                     DateTime @default(now()) @map("issued_at")

  @@map("perpetually_adaptive_enterprise_certifications")
}
