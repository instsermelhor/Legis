// cognitive-platform-schema.prisma — Prompt 277 Enterprise Cognitive Platform
// Legis Connect | Cognitive Enterprise & Organizational Memory Fabric
// ISO 42001 · XAI SHAP/LIME · Qdrant Vector DB · Neo4j Graph · Decision Intelligence
// ═══════════════════════════════════════════════════════════════════════════

model MemoryFabricNodeRecord {
  nodeId               String   @id @default(uuid()) @map("node_id")
  nodeType             String   @map("node_type")                              // DOCUMENT | DECISION | ADR | INCIDENT | LOG | METRIC
  title                String
  vectorEmbeddingId    String   @map("vector_embedding_id")
  graphNodeId          String   @map("graph_node_id")
  indexedAt            DateTime @default(now()) @map("indexed_at")

  @@index([nodeType, indexedAt])
  @@map("memory_fabric_node_records")
}

model ReasoningGraphTraceLog {
  traceId              String   @id @default(uuid()) @map("trace_id")
  queryTopic           String   @map("query_topic")
  evidenceTier         String   @map("evidence_tier")                          // AUDITED_FACT | STATISTICAL_INFERENCE | HUMAN_REVIEW_HYPOTHESIS
  confidenceScorePct   Decimal  @map("confidence_score_pct") @db.Decimal(5, 2)
  shapExplanationText  String   @db.Text @map("shap_explanation_text")
  evaluatedAt          DateTime @default(now()) @map("evaluated_at")

  @@map("reasoning_graph_trace_logs")
}

model CognitiveDecisionMetricRecord {
  metricId                     String   @id @default(uuid()) @map("metric_id")
  decisionAccuracyRatePct      Decimal  @map("decision_accuracy_rate_pct") @db.Decimal(5, 2)
  decisionLeadTimeReductionPct Decimal  @map("decision_lead_time_reduction_pct") @db.Decimal(5, 2)
  explainabilityScorePct       Decimal  @map("explainability_score_pct") @db.Decimal(5, 2)
  recordedAt                   DateTime @default(now()) @map("recorded_at")

  @@map("cognitive_decision_metric_records")
}

model CognitiveEnterpriseCertification {
  certId                String   @id @default(uuid()) @map("cert_id")
  certificateNumber     String   @unique @map("certificate_number")            // LEGIS-COGNITIVE-ENTERPRISE-CERT-2026
  classification        String   @default("COGNITIVE_ENTERPRISE_PLATFORM")
  decisionAccuracyPct   Decimal  @map("decision_accuracy_pct") @db.Decimal(5, 2)
  authorizationCode     String   @map("authorization_code")                    // AUTH-COGNITIVE-2026-FINAL
  issuedAt              DateTime @default(now()) @map("issued_at")

  @@map("cognitive_enterprise_certifications")
}
