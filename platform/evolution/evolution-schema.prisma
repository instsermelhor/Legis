model TechRadarItemRecord {
  itemId              String   @id @default(uuid()) @map("item_id")
  technologyName      String   @unique @map("technology_name")
  category            String                                                     // BACKEND | FRONTEND | AI_ML | SECURITY | INFRASTRUCTURE
  ring                String                                                     // ADOPT | TRIAL | ASSESS | WATCH
  description         String   @db.Text
  updatedAt           DateTime @default(now()) @map("updated_at")

  @@index([ring, category])
  @@map("tech_radar_item_records")
}

model ExperimentationPocLog {
  pocId               String   @id @default(uuid()) @map("poc_id")
  experimentTitle     String   @map("experiment_title")
  technologyTested    String   @map("technology_tested")
  outcome             String                                                     // ADOPTED | REJECTED | CONTINUED_EXPERIMENT
  performanceGainPct  Decimal  @map("performance_gain_pct") @db.Decimal(5, 2)
  conductedAt         DateTime @default(now()) @map("conducted_at")

  @@map("experimentation_poc_logs")
}

model TechnicalDebtMetricRecord {
  metricId            String   @id @default(uuid()) @map("metric_id")
  debtRatioPct        Decimal  @map("debt_ratio_pct") @db.Decimal(5, 2)
  sqaleRating         String   @default("A") @map("sqale_rating")            // A | B | C | D | F
  refactoringCapacity Decimal  @map("refactoring_capacity") @db.Decimal(5, 2)
  recordedAt          DateTime @default(now()) @map("recorded_at")

  @@map("technical_debt_metric_records")
}

model AdaptiveEnterpriseCertification {
  certId                String   @id @default(uuid()) @map("cert_id")
  certificateNumber     String   @unique @map("certificate_number")            // LEGIS-ADAPTIVE-ENTERPRISE-CERT-2026
  classification        String   @default("ADAPTIVE_NEXT_GENERATION_ENTERPRISE_PLATFORM")
  rdCapacityRatioPct    Decimal  @map("rd_capacity_ratio_pct") @db.Decimal(5, 2)
  authorizationCode     String   @map("authorization_code")                    // AUTH-EVOLUTION-2026-FINAL
  issuedAt              DateTime @default(now()) @map("issued_at")

  @@map("adaptive_enterprise_certifications")
}
