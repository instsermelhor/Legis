// enterprise-assurance-schema.prisma — Prompt 287 Continuously Assured Enterprise Platform
// Legis Connect | Enterprise Assurance & Verification Framework (EAF)
// IV&V Architecture · Operational Readiness System · Evidence Repository · CAPA Engine
// ═══════════════════════════════════════════════════════════════════════════

model IndependentVerificationRecord {
  checkId       String   @id @default(uuid()) @map("check_id")
  componentName String   @map("component_name")
  loa           String   @map("level_of_assurance")                           // LOA_1_AUTOMATED | LOA_2_POLICY_OPA | LOA_3_AI_SAFETY | LOA_4_OPERATIONAL_READINESS | LOA_5_INDEPENDENT_AUDIT
  passed        Boolean
  scorePct      Decimal  @map("score_pct") @db.Decimal(5, 2)
  evidenceHash  String   @unique @map("evidence_hash")
  verifiedAt    DateTime @default(now()) @map("verified_at")

  @@index([componentName, loa])
  @@map("independent_verification_records")
}

model OperationalReadinessRecord {
  recordId       String   @id @default(uuid()) @map("record_id")
  pillar         String                                                       // AVAILABILITY | RESILIENCE | SECURITY | SUPPORT_RUNBOOKS | DISASTER_RECOVERY
  scorePct       Decimal  @map("score_pct") @db.Decimal(5, 2)
  status         String                                                       // OPTIMAL | ACCEPTABLE | DEGRADED
  evaluatedAt    DateTime @default(now()) @map("evaluated_at")

  @@index([pillar, status])
  @@map("operational_readiness_records")
}

model CapaTicketRecord {
  ticketId          String    @id @default(uuid()) @map("ticket_id")
  severity          String                                                     // LOW | MEDIUM | HIGH | CRITICAL
  title             String
  slaHoursRemaining Int       @map("sla_hours_remaining")
  status            String    @default("OPEN")                                 // OPEN | IN_PROGRESS | RESOLVED | VERIFIED
  createdAt         DateTime  @default(now()) @map("created_at")
  resolvedAt        DateTime? @map("resolved_at")

  @@index([severity, status])
  @@map("capa_ticket_records")
}

model EnterpriseEvidenceRecord {
  evidenceId     String   @id @default(uuid()) @map("evidence_id")
  evidenceType   String   @map("evidence_type")                                // TEST_LOG | SAST_REPORT | AUDIT_MINUTES | OTS_PROOF | IVV_REPORT
  sha256Hash     String   @unique @map("sha256_hash")
  storedPath     String   @map("stored_path")
  registeredAt   DateTime @default(now()) @map("registered_at")

  @@map("enterprise_evidence_records")
}

model TrustedEnterpriseCertification {
  certId                       String   @id @default(uuid()) @map("cert_id")
  certificateNumber            String   @unique @map("certificate_number")    // LEGIS-TRUSTED-ENTERPRISE-CERT-287-2026
  classification               String   @default("CONTINUOUSLY_ASSURED_ENTERPRISE_PLATFORM")
  enterpriseReadinessIndexPct  Decimal  @map("enterprise_readiness_index_pct") @db.Decimal(5, 2)
  testCodeCoveragePct          Decimal  @map("test_code_coverage_pct") @db.Decimal(5, 2)
  complianceAutomationPct      Decimal  @default(100.0) @map("compliance_automation_pct") @db.Decimal(5, 2)
  crossSystemConsistencyPct    Decimal  @default(100.0) @map("cross_system_consistency_pct") @db.Decimal(5, 2)
  authorizationCode            String   @map("authorization_code")            // AUTH-TRUSTED-ENTERPRISE-287-2026-FINAL
  issuedAt                     DateTime @default(now()) @map("issued_at")

  @@map("trusted_enterprise_certifications")
}
