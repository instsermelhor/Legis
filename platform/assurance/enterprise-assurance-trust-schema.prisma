// ═══════════════════════════════════════════════════════════════════════════
// enterprise-assurance-trust-schema.prisma — Prompt 304 Trusted Autonomous Enterprise
// Legis Connect | Enterprise Autonomous Assurance Framework (EAAF)
// Assurance Domains · Trust Evidence Repository (TER) · Contextual Trust Alerts · Trusted Enterprise Certification
// ═══════════════════════════════════════════════════════════════════════════

model AssuranceDomainRecord {
  domainId                String   @id @map("domain_id")                     // AS-01 → AS-07
  name                    String
  category                String
  controlEffectivenessPct Decimal  @map("control_effectiveness_pct") @db.Decimal(5, 2) // 95.0–100.0
  evidenceCoveragePct     Decimal  @map("evidence_coverage_pct") @db.Decimal(5, 2)     // 95.0–100.0
  status                  String   @default("HEALTHY")                      // HEALTHY | WARNING | CRITICAL | AUDITING
  lastValidatedAt         DateTime @default(now()) @map("last_validated_at")

  evidenceRecords         TrustEvidenceRecordPrisma[]
  trustAlerts             ContextualTrustAlertRecord[]

  @@index([status, controlEffectivenessPct])
  @@map("assurance_domain_records")
}

model TrustEvidenceRecordPrisma {
  evidenceId          String   @id @default(uuid()) @map("evidence_id")
  domainId            String   @map("domain_id")
  category            String   @map("category")                             // AUTOMATED_VERIFICATION | INDEPENDENT_AUDIT | HUMAN_VALIDATION | INTERNAL_CERTIFICATION
  title               String
  contentHash         String   @map("content_hash")                         // SHA-256 — immutable WORM
  sourceSystem        String   @map("source_system")
  validatedBy         String   @map("validated_by")                         // SPIFFE SVID or User ID
  retentionYears      Int      @default(7) @map("retention_years")          // 7 years (ops) or 20 years (legal)
  recordedAt          DateTime @default(now()) @map("recorded_at")

  domain              AssuranceDomainRecord @relation(fields: [domainId], references: [domainId])

  @@index([domainId, category])
  @@index([contentHash])
  @@map("trust_evidence_records")
}

model ContextualTrustAlertRecord {
  alertId                String   @id @default(uuid()) @map("alert_id")
  severity               String   @default("MEDIUM")                       // LOW | MEDIUM | HIGH | CRITICAL
  domainId               String   @map("domain_id")
  summary                String   @db.Text
  correlatedEvidenceIds  Json     @map("correlated_evidence_ids")          // string[]
  resolvedAt             DateTime? @map("resolved_at")
  detectedAt             DateTime @default(now()) @map("detected_at")

  domain                 AssuranceDomainRecord @relation(fields: [domainId], references: [domainId])

  @@index([domainId, severity])
  @@map("contextual_trust_alert_records")
}

model TrustedEnterpriseCertification {
  certId                       String   @id @default(uuid()) @map("cert_id")
  certificateNumber            String   @unique @map("certificate_number")  // LEGIS-TRUSTED-ENTERPRISE-CERT-304-2026
  classification               String   @default("TRUSTED_AUTONOMOUS_ENTERPRISE_PLATFORM")
  totalDomainsCertified        Int      @default(7) @map("total_domains_certified")
  trustMaturityIndexPct        Decimal  @map("trust_maturity_index_pct") @db.Decimal(5, 2)  // 99.1
  controlEffectivenessAvgPct   Decimal  @map("control_effectiveness_avg_pct") @db.Decimal(5, 2)
  evidenceCoverageAvgPct       Decimal  @map("evidence_coverage_avg_pct") @db.Decimal(5, 2)
  humanOversightIntegration    Boolean  @default(true) @map("human_oversight_integration")
  digitalTrustMaturityLevel    Int      @default(4) @map("digital_trust_maturity_level")    // 4 = Automatizado
  authorizationCode            String   @map("authorization_code")          // AUTH-TRUSTED-304-2026-FINAL
  issuedAt                     DateTime @default(now()) @map("issued_at")

  @@map("trusted_enterprise_certifications")
}
