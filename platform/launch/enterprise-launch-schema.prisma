// ═══════════════════════════════════════════════════════════════════════════
// enterprise-launch-schema.prisma — Prompt 295 Production-Ready Enterprise Platform
// Legis Connect | Enterprise Production Readiness Framework (EPRF)
// Production Gates · GitOps Deployment · Hypercare · Operational KPIs
// ═══════════════════════════════════════════════════════════════════════════

model ProductionGateRecord {
  gateId        String   @id @default(uuid()) @map("gate_id")
  gateNumber    Int      @map("gate_number")
  gateName      String   @map("gate_name")
  status        String   @default("PASSED")                              // PASSED | FAILED | CONDITIONALLY_PASSED
  scorePct      Decimal  @map("score_pct") @db.Decimal(5, 2)
  signoffOwner  String   @map("signoff_owner")
  evaluatedAt   DateTime @default(now()) @map("evaluated_at")

  @@index([gateNumber, status])
  @@map("production_gate_records")
}

model ProductionDeploymentRecord {
  deploymentId     String   @id @default(uuid()) @map("deployment_id")
  version          String
  strategy         String   @default("CANARY")                           // CANARY | BLUE_GREEN | ROLLING
  canaryTrafficPct Int      @map("canary_traffic_pct")
  errorRatePct     Decimal  @map("error_rate_pct") @db.Decimal(5, 4)
  status           String   @default("STABLE")                           // PROMOTED | ROLLING_BACK | STABLE
  deployedAt       DateTime @default(now()) @map("deployed_at")

  @@index([version, status])
  @@map("production_deployment_records")
}

model HypercareIncidentRecord {
  incidentId      String    @id @default(uuid()) @map("incident_id")
  severity        String                                                 // LOW | MEDIUM | HIGH | CRITICAL
  title           String
  mttrMinutes     Decimal   @map("mttr_minutes") @db.Decimal(4, 1)
  resolvedBy      String    @map("resolved_by")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([severity, createdAt])
  @@map("hypercare_incident_records")
}

model EnterpriseProductionCertification {
  certId                     String   @id @default(uuid()) @map("cert_id")
  certificateNumber          String   @unique @map("certificate_number") // LEGIS-ENTERPRISE-PRODUCTION-READY-CERT-295-2026
  classification             String   @default("PRODUCTION_READY_ENTERPRISE_PLATFORM")
  goLiveReadinessScorePct    Decimal  @map("go_live_readiness_score_pct") @db.Decimal(5, 2)
  productionGatesPassedCount Int      @default(5) @map("production_gates_passed_count")
  totalMasterBlueprintsCount Int      @default(295) @map("total_master_blueprints_count")
  totalRatifiedAdrsCount     Int      @default(81) @map("total_ratified_adrs_count")
  authorizationCode          String   @map("authorization_code")         // AUTH-LAUNCH-295-2026-FINAL
  issuedAt                   DateTime @default(now()) @map("issued_at")

  @@map("enterprise_production_certifications")
}
