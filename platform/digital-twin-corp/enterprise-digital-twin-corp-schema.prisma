// ═══════════════════════════════════════════════════════════════════════════
// enterprise-digital-twin-corp-schema.prisma — Prompt 303 Living Intelligent Enterprise
// Legis Connect | Enterprise Digital Twin Framework (EDTF)
// DT Domain Registry · Simulation Scenarios · Model Drift Alerts · Living Enterprise Cert
// ═══════════════════════════════════════════════════════════════════════════

model DigitalTwinDomainRecord {
  domainId         String   @id @map("domain_id")                    // DT-01 → DT-08
  name             String
  description      String   @db.Text
  fidelityPct      Decimal  @map("fidelity_pct") @db.Decimal(5, 2)  // 95.0–100.0
  syncLagMinutes   Int      @map("sync_lag_minutes")
  status           String   @default("SYNCHRONIZED")                 // SYNCHRONIZED | LAGGING | DRIFTED | OFFLINE
  dataSource       String   @map("data_source")
  lastSyncedAt     DateTime @default(now()) @map("last_synced_at")

  driftAlerts      ModelDriftAlertRecord[]

  @@index([status, fidelityPct])
  @@map("digital_twin_domain_records")
}

model SimulationScenarioRecord {
  scenarioId           String   @id @default(uuid()) @map("scenario_id")
  name                 String
  category             String                                         // WHAT_IF_ARCHITECTURAL | STRESS_RESILIENCE | REGULATORY_IMPACT | STRATEGIC_SCENARIO
  dataLayer            String   @map("data_layer")                   // OBSERVED (forbidden for scenarios) | SIMULATED | HYPOTHESIS | PROJECTION
  hypothesesDeclared   Json     @map("hypotheses_declared")          // string[]
  inputDataSources     Json     @map("input_data_sources")           // string[]
  successCriteria      Json     @map("success_criteria")             // string[]
  rejectionCriteria    Json     @map("rejection_criteria")           // string[]
  validityWindowDays   Int      @map("validity_window_days")
  humanGateRequired    Boolean  @default(true) @map("human_gate_required")
  humanGateApprovedBy  String?  @map("human_gate_approved_by")
  humanGateApprovedAt  DateTime? @map("human_gate_approved_at")
  outcomeObservedAt    DateTime? @map("outcome_observed_at")         // for prediction vs. reality tracking
  predictionAccuracyPct Decimal? @map("prediction_accuracy_pct") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([category, dataLayer])
  @@map("simulation_scenario_records")
}

model ModelDriftAlertRecord {
  alertId                String   @id @default(uuid()) @map("alert_id")
  domainId               String   @map("domain_id")
  driftPct               Decimal  @map("drift_pct") @db.Decimal(5, 2)
  requiresRecalibration  Boolean  @default(false) @map("requires_recalibration")
  resolvedAt             DateTime? @map("resolved_at")
  detectedAt             DateTime @default(now()) @map("detected_at")

  domain  DigitalTwinDomainRecord @relation(fields: [domainId], references: [domainId])

  @@index([domainId, requiresRecalibration])
  @@map("model_drift_alert_records")
}

model LivingEnterpriseCertification {
  certId                       String   @id @default(uuid()) @map("cert_id")
  certificateNumber            String   @unique @map("certificate_number")  // LEGIS-LIVING-ENTERPRISE-CERT-303-2026
  classification               String   @default("LIVING_INTELLIGENT_ENTERPRISE_PLATFORM")
  totalDomainsCertified        Int      @default(8) @map("total_domains_certified")
  digitalTwinMaturityIndexPct  Decimal  @map("digital_twin_maturity_index_pct") @db.Decimal(5, 2)  // 99.0
  modelFidelityAvgPct          Decimal  @map("model_fidelity_avg_pct") @db.Decimal(5, 2)
  syncLagMaxMinutes            Int      @default(60) @map("sync_lag_max_minutes")
  humanGateCompliance          Boolean  @default(true) @map("human_gate_compliance")
  livingEnterpriseMaturityLevel Int     @default(4) @map("living_enterprise_maturity_level")  // 4 = Sincronizado
  authorizationCode            String   @map("authorization_code")          // AUTH-LIVING-303-2026-FINAL
  issuedAt                     DateTime @default(now()) @map("issued_at")

  @@map("living_enterprise_certifications")
}
