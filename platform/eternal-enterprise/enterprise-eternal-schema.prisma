// ═══════════════════════════════════════════════════════════════════════════
// enterprise-eternal-schema.prisma — Prompt 300 (FINAL) Self-Evolving Governed Enterprise Platform
// Legis Connect | Enterprise Autonomous Evolution Framework (EAEF)
// Meta-Governance · Institutional Memory · Evolution Cycles · Eternal Certification
// ═══════════════════════════════════════════════════════════════════════════

model GovernanceFrameworkStatusRecord {
  frameworkId      String   @id @map("framework_id")                     // fwk-p282 → fwk-p299
  name             String
  sourcePrompt     Int      @map("source_prompt")                        // 282–299
  complianceScore  Decimal  @map("compliance_score") @db.Decimal(5, 2)
  status           String   @default("ACTIVE")                           // ACTIVE | UNDER_REVIEW | DEPRECATED
  lastReviewedAt   DateTime @default(now()) @map("last_reviewed_at")

  @@index([sourcePrompt, status])
  @@map("governance_framework_status_records")
}

model InstitutionalMemorySnapshotRecord {
  snapshotId                     String   @id @default(uuid()) @map("snapshot_id")
  totalBlueprintsCount           Int      @default(300) @map("total_blueprints_count")
  totalRatifiedAdrsCount         Int      @default(86) @map("total_ratified_adrs_count")
  totalTypeScriptEnginesCount    Int      @default(15) @map("total_typescript_engines_count")
  institutionalEvolutionIndexPct Decimal  @map("institutional_evolution_index_pct") @db.Decimal(5, 2)
  buildVerificationStatus        String   @default("VERIFIED_1049_MODULES_0_ERRORS") @map("build_verification_status")
  snapshotCreatedAt              DateTime @default(now()) @map("snapshot_created_at")

  @@map("institutional_memory_snapshot_records")
}

model EvolutionCycleRecord {
  cycleId      String   @id @default(uuid()) @map("cycle_id")
  cycleType    String   @map("cycle_type")                               // MINOR_SPRINT | MAJOR_QUARTERLY | CONSTITUTIONAL_ANNUAL | CIVILIZATION_QUINQUENNIAL
  triggeredBy  String   @map("triggered_by")
  outcome      String   @db.Text
  completedAt  DateTime @default(now()) @map("completed_at")

  @@index([cycleType, completedAt])
  @@map("evolution_cycle_records")
}

model EternalEnterpriseCertification {
  certId                         String   @id @default(uuid()) @map("cert_id")
  certificateNumber              String   @unique @map("certificate_number")   // LEGIS-ETERNAL-ENTERPRISE-CERT-300-2026
  classification                 String   @default("SELF_EVOLVING_GOVERNED_ENTERPRISE_PLATFORM")
  institutionalEvolutionIndexPct Decimal  @map("institutional_evolution_index_pct") @db.Decimal(5, 2)
  totalMasterBlueprintsCount     Int      @default(300) @map("total_master_blueprints_count")
  totalRatifiedAdrsCount         Int      @default(86) @map("total_ratified_adrs_count")
  totalTypeScriptEnginesCount    Int      @default(15) @map("total_typescript_engines_count")
  humanPrimacyCompliancePct      Decimal  @default(100.0) @map("human_primacy_compliance_pct") @db.Decimal(5, 2)
  governanceDriftDetected        Boolean  @default(false) @map("governance_drift_detected")
  lceraProgramStatus             String   @default("COMPLETE") @map("lcera_program_status")   // COMPLETE | IN_PROGRESS
  authorizationCode              String   @map("authorization_code")           // AUTH-ETERNAL-300-2026-FINAL
  issuedAt                       DateTime @default(now()) @map("issued_at")

  @@map("eternal_enterprise_certifications")
}
