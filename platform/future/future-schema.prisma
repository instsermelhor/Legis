// future-schema.prisma — Prompt 265 Strategic Meta-Audit & Future Readiness
// Legis Connect | World-Class Enterprise Certification 2040
// Evolutionary Architecture · PQC · ISO 42001 · Architecture Fitness Functions
// ═══════════════════════════════════════════════════════════════════════════

model ArchitectureFitnessMetric {
  metricId           String   @id @default(uuid()) @map("metric_id")
  functionName       String   @map("function_name")
  category           String                                                     // MODULARITY | COUPLING | SECURITY | PERFORMANCE | GREENOPS
  passed             Boolean  @default(true)
  scorePct           Decimal  @map("score_pct") @db.Decimal(5, 2)
  evaluatedAt        DateTime @default(now()) @map("evaluated_at")

  @@index([category, passed])
  @@map("architecture_fitness_metrics")
}

model QuantumReadinessAudit {
  auditId            String   @id @default(uuid()) @map("audit_id")
  pqcAlgorithm       String   @map("pqc_algorithm")                             // CRYSTALS-Dilithium-3 | Kyber768
  signatureScheme    String   @map("signature_scheme")
  hybridTlsEnabled   Boolean  @default(true) @map("hybrid_tls_enabled")
  readinessScorePct  Decimal  @map("readiness_score_pct") @db.Decimal(5, 2)
  evaluatedAt        DateTime @default(now()) @map("evaluated_at")

  @@map("quantum_readiness_audits")
}

model TechnologyRadar2040Item {
  itemId             String   @id @default(uuid()) @map("item_id")
  name               String   @unique
  category           String                                                     // INFRASTRUCTURE | BACKEND | FRONTEND | AI_ML | SECURITY
  ring               String                                                     // ADOPT | TRIAL | ASSESS | WATCH | HOLD
  description        String   @db.Text
  updatedAt          DateTime @default(now()) @map("updated_at")

  @@index([ring, category])
  @@map("technology_radar_2040_items")
}

model WorldClassCertificationRecord {
  certId                String   @id @default(uuid()) @map("cert_id")
  certificateNumber     String   @unique @map("certificate_number")            // LEGIS-WORLD-CLASS-CERT-2040-FINAL
  classification        String   @default("WORLD_CLASS")                       // WORLD_CLASS | PLATINUM | GOLD
  globalScore           Decimal  @map("global_score") @db.Decimal(5, 2)
  totalPromptsCompleted Int      @default(265) @map("total_prompts_completed")
  totalAdrsRecorded     Int      @default(51) @map("total_adrs_recorded")
  issuedAt              DateTime @default(now()) @map("issued_at")

  @@map("world_class_certification_records")
}
