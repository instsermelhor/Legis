# ─── Legis Connect — Template de Variáveis de Ambiente (.env.example) ───────────
#
# INSTRUÇÕES DE SEGURANÇA:
# 1. Copie este arquivo para .env.local em ambiente de desenvolvimento local.
# 2. Em Staging/Produção, configure as variáveis diretamente no Dashboard da Vercel / Secret Manager.
# 3. NUNCA atribua valores reais neste arquivo (.env.example).
# 4. Variáveis com prefixo VITE_ são públicas e visíveis no bundle do navegador.
# 5. Variáveis SEM prefixo VITE_ são estritamente SERVER-ONLY e secretas.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Supabase (Frontend + Backend) ─────────────────────────────────────────────
# URL pública do projeto Supabase
VITE_SUPABASE_URL=<YOUR_SUPABASE_URL>

# Chave anônima pública (protegida por Row-Level Security no PostgreSQL)
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# ─── Gemini AI (SERVER-ONLY — Nunca expor no frontend) ─────────────────────────
# API Key do Google Gemini (utilizada pelo proxy serverless em /api/gemini)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# ─── Banco de Dados (SERVER-ONLY — Prisma ORM & Migrations) ────────────────────
# Connection string PostgreSQL de produção
DATABASE_URL=<YOUR_DATABASE_URL>

# ─── Sentry Monitoramento (Frontend Public DSN / Server Auth Token) ────────────
# DSN público para report de erros do frontend
VITE_SENTRY_DSN=<YOUR_SENTRY_DSN>

# Token de autenticação Sentry para upload de Source Maps no CI/CD (SERVER-ONLY)
SENTRY_AUTH_TOKEN=<YOUR_SENTRY_AUTH_TOKEN>

# ─── Feature Flags & Identificação ─────────────────────────────────────────────
VITE_IS_BETA=true
VITE_APP_VERSION=1.0.0-beta
VITE_APP_URL=https://legisconnect.com.br

# ─── Configurações do Proxy Server / Port ──────────────────────────────────────
PROXY_PORT=3001
